# ----- Server -----
PORT=3000

# ----- Meta App (Tech Provider) -----
# These three can be configured at runtime via the /admin.html UI (stored in
# Postgres) instead of here. If set in both, the DB value wins. Leave blank to
# manage them entirely through the admin UI.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=

# Graph API version used for all calls.
GRAPH_API_VERSION=v21.0

# ----- Admin UI -----
# Bearer token gating /admin.html and the /admin/settings API. Must be set to
# use the admin UI. Generate with: openssl rand -hex 24
ADMIN_TOKEN=set-a-long-random-string

# ----- Webhooks -----
# Token you set in the App Dashboard webhook config; must match the challenge verification.
WEBHOOK_VERIFY_TOKEN=set-a-long-random-string

# ----- Tenant token encryption -----
# 32-byte key (hex, 64 chars) used to encrypt client access tokens at rest.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=change-me-64-hex-chars

# ----- Database (Postgres) -----
# Connection string. On Easypanel use the internal service hostname.
DATABASE_URL=postgres://user:password@host:5432/whatsappapi
# Set to "true" if your Postgres requires SSL (managed/external providers).
DATABASE_SSL=false
